# Copy to .env.local. Use a development Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required only by the separate library worker.
SUPABASE_WORKER_KEY=

# Optional Telegram integration. Keep the service key and webhook secret on the server.
SUPABASE_TELEGRAM_SERVICE_KEY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Worker and webhook registration only.
TELEGRAM_BOT_TOKEN=

# Optional AI. Leave off until provider eligibility and rates have been approved.
STUDYOS_AI_PROVIDER=
STUDYOS_GEMINI_APPROVED=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_REQUEST_LIMIT=
AI_DAILY_TOKEN_LIMIT=
AI_DAILY_COST_MICROUSD=
GEMINI_INPUT_USD_PER_MILLION_MICRO=
GEMINI_OUTPUT_USD_PER_MILLION_MICRO=
